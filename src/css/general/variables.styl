// =============================================================================
// CSS Custom Properties (CSS Variables)
// =============================================================================

:root
  // Theme Colors
  // ---------------------------------------------------------------------------
  --color-primary: #dbc52d           // Gold/Yellow - matches current accent
  --color-black: #1F1F1F           // Black - main background
  --color-white: #ffffff     // Primary text color
  --color-modal: #1F1F1F
  
  // Status Colors
  // ---------------------------------------------------------------------------
  --color-success: #43a047          // Green - positive performance
  --color-error: #e74c3c            // Red - negative performance
  --color-warning: #ff9800          // Orange - warning states
  --color-info: #2196f3             // Blue - informational
  
  // Spacing Scale
  // ---------------------------------------------------------------------------
  --spacing: 6px
  
  // Typography Scale
  // ---------------------------------------------------------------------------
  --font-family-primary: "Roboto", sans-serif
  --font-weight-normal: 400
  --font-weight-medium: 500
  --font-weight-bold: 700
  --font-weight-black: 900
  
  --font-size-base: 14px
  
  --line-height-tight: 1.2
  --line-height-normal: 1.5
  --line-height-relaxed: 1.7
  
  // Layout & Sizing
  // ---------------------------------------------------------------------------
  --border-radius: 4px
  
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.12), 0 1px 2px rgba(0, 0, 0, 0.24)
  --shadow-md: 0 3px 6px rgba(0, 0, 0, 0.16), 0 3px 6px rgba(0, 0, 0, 0.23)
  --shadow-lg: 0 10px 20px rgba(0, 0, 0, 0.19), 0 6px 6px rgba(0, 0, 0, 0.23)
  
  // Transitions & Animations
  // ---------------------------------------------------------------------------
  --transition-fast: 0.15s ease
  --transition-normal: 0.3s ease
  --transition-slow: 0.5s ease
  --transition-fade: 1s ease-in-out    // Globe fade transition
  
  // Z-Index Scale
  // ---------------------------------------------------------------------------
  --z-base: 0
  --z-modal: 500
  
  // Breakpoints (for use with CSS container queries or JS)
  // ---------------------------------------------------------------------------
  --breakpoint-mobile: 480px
  --breakpoint-tablet: 768px
  --breakpoint-desktop: 1024px
  --breakpoint-wide: 1200px
  
  // Custom Properties for Dynamic Values
  // ---------------------------------------------------------------------------
  --vh: 1vh                         // Dynamic viewport height (set via JS)
