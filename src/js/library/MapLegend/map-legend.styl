.map-legend
  position: absolute
  bottom: 10px
  right: 10px
  
  width: 240px
  background: var(--color-black)
  border: 1px solid rgba(255, 255, 255, 0.3)
  border-radius: var(--border-radius)
  padding: calc(var(--spacing) * 2)
  
  color: var(--color-white)
  font-size: var(--font-size-base)

.map-legend__toggle
  display: none

.map-legend__content
  display: block

.map-legend__label
  position: relative
  
  display: flex
  flex-direction: column
  align-items: center
  margin-bottom: calc(var(--spacing) * 1)
  padding: calc(var(--spacing) * 1)
  
  text-align: center

.map-legend__label-highlight
  color: var(--color-primary)
  font-size: calc(var(--font-size-base) * 1.1)
  font-weight: var(--font-weight-bold)
  text-transform: uppercase
  letter-spacing: 2px
  text-shadow: 0 0 10px rgba(219, 197, 45, 0.3)
  margin-bottom: calc(var(--spacing) * 0.5)

.map-legend__label-period
  color: rgba(255, 255, 255, 0.7)
  font-size: calc(var(--font-size-base) * 0.85)
  font-weight: var(--font-weight-medium)
  letter-spacing: 1px

.map-legend__values
  display: flex
  justify-content: space-between
  margin-bottom: var(--spacing)
  
  font-size: 12px
  color: #cccccc

  > span:not(:last-child):not(:first-child)
    transform: translateX(50%)

.map-legend__colors
  position: relative
  
  height: 10px
  border-radius: calc(var(--border-radius) / 2)
  // background: linear-gradient(
  //   to right,
  //   #43a047 0%,     /* Solid green for < 2% */
  //   #43a047 15%,    /* End of solid green section */
  //   #8bc34a 35%,    /* Start gradient - Yellow-green */
  //   #ffc107 50%,    /* Middle gradient - Yellow */
  //   #ff5722 65%,    /* Gradient - Deep orange */
  //   #b71c1c 85%,    /* End gradient - Darkest red */
  //   #b71c1c 100%    /* Solid red for > 10% */
  // )
  background: url('/img/legend-colors.png') repeat center
  background-size: contain

.map-legend__marker
  position: absolute
  top: 0
  
  width: 1px
  height: 100%
  background: rgba(255, 255, 255, 0.8)
  
  &--2
    left: 15% // 2% is at the boundary between solid green and gradient start
  
  &--5
    left: 50% // 5% is in the middle of the gradient (yellow section)
  
  &--10
    left: 85% // 10% is at the boundary between gradient end and solid red

.map-legend__pattern-section
  margin-top: calc(var(--spacing) * 2)
  padding-top: calc(var(--spacing) * 2)
  border-top: 1px solid rgba(255, 255, 255, 0.2)

.map-legend__pattern-indicator
  display: flex
  align-items: center
  gap: calc(var(--spacing) * 1.5)

.map-legend__pattern-sample
  position: relative
  
  width: 30px
  height: 16px
  // background: linear-gradient(
  //   to right,
  //   #43a047 0%,     /* Green (low inflation) */
  //   #ffc107 50%,    /* Yellow (medium inflation) */
  //   #b71c1c 100%    /* Red (high inflation) */
  // )
  background: url('/img/legend-no-data.png') no-repeat center
  background-size: cover
  border-radius: calc(var(--border-radius) / 2)
  overflow: hidden
  
  // &::after
  //   position: absolute
  //   top: 0
  //   left: 0
  //   right: 0
  //   bottom: 0
    
  //   background-image: repeating-linear-gradient(
  //     45deg,
  //     transparent,
  //     transparent 2px,
  //     rgba(255, 255, 255, 0.4) 2px,
  //     rgba(255, 255, 255, 0.4) 4px
  //   )
    
  //   content: ''

.map-legend__pattern-label
  font-size: 12px
  color: #cccccc
  font-weight: var(--font-weight-medium)

@media (max-width: 767px)
  .map-legend
    bottom: calc(var(--spacing) * 2)
    right: calc(var(--spacing) * 2)
    
    width: auto
    min-width: 44px
    padding: 0
    border-radius: 50%
    transition: all 0.3s ease

    &--open
      width: 240px
      border-radius: var(--border-radius)
      padding: calc(var(--spacing) * 2)

  .map-legend__toggle
    position: relative
    z-index: 1
    
    display: flex
    align-items: center
    justify-content: center
    width: 44px
    height: 40px
    border: none
    background: transparent
    
    color: var(--color-primary)
    font-size: calc(var(--font-size-base) * 1.4)
    font-weight: var(--font-weight-bold)
    cursor: pointer

    .map-legend--open &
      position: absolute
      top: calc(var(--spacing) * 1)
      right: calc(var(--spacing) * 1)
      
      width: 24px
      height: 24px
      
      color: rgba(255, 255, 255, 0.7)
      font-size: calc(var(--font-size-base) * 1.2)

  .map-legend__content
    display: none
    
    .map-legend--open &
      display: block

  .map-legend__label
    margin-bottom: calc(var(--spacing) * 0.5)
    padding: calc(var(--spacing) * 0.5)

  .map-legend__label-highlight
    font-size: var(--font-size-base)
    letter-spacing: 1px
    margin-bottom: calc(var(--spacing) * 0.25)

  .map-legend__label-period
    font-size: calc(var(--font-size-base) * 0.8)

  .map-legend__values
    font-size: 11px

  .map-legend__pattern-section
    margin-top: calc(var(--spacing) * 1.5)
    padding-top: calc(var(--spacing) * 1.5)

  .map-legend__pattern-indicator
    gap: calc(var(--spacing))

  .map-legend__pattern-sample
    width: 24px
    height: 12px

  .map-legend__pattern-label
    font-size: 11px
