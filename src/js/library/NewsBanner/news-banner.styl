.news-banner
  position: relative
  
  display: flex
  align-items: center
  height: 50%
  width: 100%
  background: linear-gradient(90deg, var(--color-base) 0%, rgba(42, 42, 42, 0.8) 100%)
  
  overflow: hidden

.news-banner__container
  display: flex
  align-items: center
  width: 100%
  height: 100%

.news-banner__label
  position: relative
  
  flex-shrink: 0
  width: 65px
  padding: 0 15px
  background: var(--color-error)
  
  color: var(--color-white)
  font-size: calc(var(--font-size-base) * 0.8)
  font-weight: var(--font-weight-black)
  text-transform: uppercase
  letter-spacing: 1px

.news-banner__content
  position: relative
  
  flex: 1
  height: 100%
  overflow: hidden

.news-banner__item
  display: flex
  align-items: center
  height: 100%
  padding: 0 calc(var(--spacing) * 4)
  
  color: var(--color-white)
  font-size: calc(var(--font-size-base) * 0.9)
  font-weight: var(--font-weight-medium)
  white-space: nowrap
  text-overflow: ellipsis
  overflow: hidden
  
  transform: translateX(0)
  opacity: 1
  transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 0.4s ease-out
  
  @media (max-width: 768px)
    align-items: center
    padding: 0 calc(var(--spacing) * 2)
    white-space: normal
    text-overflow: unset
    overflow: visible
    line-height: var(--line-height-tight)
    font-size: calc(var(--font-size-base) * 0.8)
  
  &::before
    content: '•'
    margin-right: calc(var(--spacing) * 2)
    color: var(--color-error)
    font-weight: var(--font-weight-bold)
    flex-shrink: 0
    
    @media (max-width: 768px)
      margin-right: calc(var(--spacing))
  
  &--sliding
    transform: translateX(20px)
    opacity: 0
  
  &--sliding
    transform: translateX(20px)
    opacity: 0
    transform: translateX(20px)
    opacity: 0
