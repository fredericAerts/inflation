.price-banner
  position: relative
  
  display: flex
  height: 30px
  background-color: var(--color-base)
  
  color: var(--color-white)
  font-size: 11px
  
  overflow: hidden
  cursor: help

.price-banner__context
  position: relative

  flex-shrink: 0
  width: 65px
  padding: 0 var(--spacing) 0 calc(var(--spacing) * 2)
  
  color: var(--color-primary)
  text-align: center
  line-height: 30px

  > span
    position: relative
    top: 1px

    display: block
    font-size: 10px
    line-height: 12px

    white-space: nowrap
  
  > strong
    display: block
    text-transform: uppercase
    
    font-size: 18px
    font-weight: var(--font-weight-black)
    line-height: 18px

  &::after
    position: absolute
    top: 0
    right: -10px
    z-index: calc(var(--z-base) + 1)
    
    width: 10px
    height: 100%
    background: linear-gradient(to right, var(--color-black), transparent)

    content: ""

.price-banner__scroll
  position: relative
  top: 1px
  overflow: hidden
  white-space: nowrap

.price-banner__scroll__ticker
  flex-wrap: nowrap
  
  display: flex
  margin: 0
  padding: 0

  list-style: none
  
  will-change: transform

  > li
    flex-shrink: 0
    
    padding: 0 10px

