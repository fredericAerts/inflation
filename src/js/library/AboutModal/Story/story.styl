.story
  position relative

  font-family 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif
  line-height 1.6

.story__header
  margin-bottom 2rem

.story__title
  margin 0 0 1rem 0
  
  font-size 2.5rem
  font-weight 700

.story__section
  margin-bottom 3rem

.story__section-title
  margin 0 0 1.5rem 0
  
  font-size 1.5rem
  font-weight 600

.story__paragraph
  margin 0 0 1.5rem 0
  
  font-size 1rem
  text-align justify
  
  &:last-child
    margin-bottom 0

.story__footer
  margin-top 3rem
  padding-top 2rem
  
  border-top 1px solid #e1e5e9
  
  text-align center
  color #6c757d

@media (max-width: 768px)
  .story
    padding 0 0.75rem

  .story__title
    font-size 2rem

  .story__section-title
    font-size 1.25rem

  .story__section
    margin-bottom 2rem