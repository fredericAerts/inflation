.story__section
  margin-bottom calc(var(--spacing) * 6)
  
  &:last-child
    margin-bottom 0

.story__paragraph
  text-align justify

.story__link
  background none
  border none
  padding 0
  margin 0
  
  color var(--color-primary)
  font inherit
  text-decoration underline
  text-transform: uppercase
  cursor pointer
  
  &:hover
    text-decoration underline
    
  &:focus
    outline 1px dotted var(--color-primary)