.about-modal
  position: fixed
  top: 0
  left: 0
  z-index: var(--z-modal)
  
  display: flex
  width: 100%
  height: 100%
  background-color: rgba(0, 0, 0, 0.9)

.about-modal__content
  position: relative
  
  display: flex
  width: 100%
  height: 100%
  background: var(--color-black)

.about-modal__close
  position: absolute
  top: calc(var(--spacing) * 3)
  right: calc(var(--spacing) * 3)
  z-index: calc(var(--z-modal) + 1)
  
  display: flex
  align-items: center
  justify-content: center
  width: calc(var(--spacing) * 8)
  height: calc(var(--spacing) * 8)
  border: 2px solid var(--color-primary)
  border-radius: 50%
  background: rgba(0, 0, 0, 0.9)
  
  color: var(--color-primary)
  font-size: calc(var(--font-size-base) * 1.8)
  font-weight: var(--font-weight-bold)
  cursor: pointer
  transition: var(--transition-fast)
  backdrop-filter: blur(10px)

  &:hover
    background: var(--color-primary)
    color: var(--color-black)
    box-shadow: 0 0 20px rgba(219, 197, 45, 0.5)

.about-modal__body
  display: flex
  width: 100%
  height: 100%
  
  @media (max-width: 768px)
    margin-left: 0

  @media (min-width: 769px)
    margin-left: 320px

.about-modal__main
  flex: 1
  
  padding: calc(var(--spacing) * 8) calc(var(--spacing) * 6)
  overflow-y: auto
  
  color: var(--color-white)

.about-modal__title
  margin: 0 0 calc(var(--spacing) * 6) 0
  
  color: var(--color-primary)
  font-size: calc(var(--font-size-base) * 2.5)
  font-weight: var(--font-weight-black)
  text-transform: uppercase
  letter-spacing: 2px

.about-modal__text
  color: var(--color-white)
  font-size: calc(var(--font-size-base) * 1.1)
  line-height: var(--line-height-relaxed)

  p
    margin: 0 0 calc(var(--spacing) * 4) 0
    
    &:last-child
      margin-bottom: 0

  h2,
  h3
    margin: calc(var(--spacing) * 6) 0 calc(var(--spacing) * 3) 0
    
    color: var(--color-primary)
    font-size: calc(var(--font-size-base) * 1.3)
    font-weight: var(--font-weight-bold)
    text-transform: uppercase
    letter-spacing: 1px

  ul
    margin: 0 0 calc(var(--spacing) * 4) 0
    
    li
      margin-bottom: calc(var(--spacing) * 2)
      
      strong
        color: var(--color-primary)

  .disclaimer
    display: block
    margin-top: calc(var(--spacing) * 6)
    
    color: rgba(255, 255, 255, 0.6)
    font-size: calc(var(--font-size-base) * 0.8)
    font-weight: var(--font-weight-bold)
    text-align: left
    text-transform: uppercase
    letter-spacing: 0.5px
