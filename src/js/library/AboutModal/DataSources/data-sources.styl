.data-sources
  // Inherit color and typography from parent modal

  p:first-letter
    color inherit
    font-size inherit
    font-weight inherit

.data-sources__section
  margin-bottom calc(var(--spacing) * 6)
  
  &:last-of-type
    margin-bottom calc(var(--spacing) * 4)

.data-sources__section-title
  // Inherits h3 styling from about-modal.styl

.data-sources__list
  // Inherits ul styling from about-modal.styl

.data-sources__item
  // Inherits li styling from about-modal.styl

.data-sources ul li strong
  color inherit

.data-sources__link
  color var(--color-primary)
  text-decoration underline
  word-break break-all
  
  &:hover
    text-decoration underline