.data-sources
  max-width: 1024px

.data-sources__section
  margin-bottom calc(var(--spacing) * 6)
  
  &:last-of-type
    margin-bottom calc(var(--spacing) * 4)

.data-sources .data-sources__item strong
  color inherit

.data-sources__link
  color var(--color-primary)
  text-decoration underline
  word-break break-all
  
  &:hover
    text-decoration underline