.country-modal
  position: fixed
  z-index: var(--z-modal)
  top: 0
  left: 0

  display: flex
  justify-content: center
  align-items: center
  
  width: 100%
  height: 100%
  background-color: var(--color-base)

.country-modal__content
  position: relative
  
  display: flex
  flex-direction: column
  width: 100%
  height: 100%
  padding: calc(var(--spacing) * 6)
  background: var(--color-black)
  
  overflow-y: auto
  color: var(--color-white)

.country-modal__close
  position: absolute
  top: calc(var(--spacing) * 3)
  right: calc(var(--spacing) * 3)
  z-index: calc(var(--z-modal) + 1)
  
  display: flex
  align-items: center
  justify-content: center
  width: calc(var(--spacing) * 8)
  height: calc(var(--spacing) * 8)
  border: 2px solid var(--color-primary)
  border-radius: 50%
  background: rgba(0, 0, 0, 0.9)
  
  color: var(--color-primary)
  font-size: calc(var(--font-size-base) * 1.8)
  font-weight: var(--font-weight-bold)
  cursor: pointer
  transition: var(--transition-fast)
  backdrop-filter: blur(10px)

  &:hover
    background: var(--color-primary)
    color: var(--color-black)
    box-shadow: 0 0 20px rgba(219, 197, 45, 0.5)

.country-modal__content__row
  display: flex
  flex-wrap: wrap
  gap: calc(var(--spacing) * 4)
  margin-bottom: calc(var(--spacing) * 6)

  &:last-child
    margin-bottom: 0

.country-modal__content__row__cell
  flex: 1
  min-width: 0
  width: 100%

  @media (min-width: var(--breakpoint-tablet))
    &.tablet-50
      width: calc(50% - (var(--spacing) * 2))
      flex: 0 0 calc(50% - (var(--spacing) * 2))

  &.country-modal__content__row__cell--50
    width: calc(50% - (var(--spacing) * 2.67))
    flex: 0 0 calc(50% - (var(--spacing) * 2.67))

.country-modal__header
  display: flex
  flex-direction: column
  justify-content: center
  align-items: center
  height: 400px
  padding: calc(var(--spacing) * 6)
  background: linear-gradient(135deg, rgba(219, 197, 45, 0.05) 0%, rgba(0, 0, 0, 0.3) 100%)
  border: 1px solid rgba(219, 197, 45, 0.2)
  border-radius: calc(var(--border-radius) * 2)
  position: relative
  overflow: hidden

  &::before
    content: ''
    position: absolute
    top: 0
    left: 0
    right: 0
    height: 2px
    background: linear-gradient(90deg, transparent 0%, var(--color-primary) 50%, transparent 100%)

  .country-name
    margin: 0 0 calc(var(--spacing) * 4) 0
    color: rgba(255, 255, 255, 0.8)
    font-size: calc(var(--font-size-base) * 1.1)
    font-weight: var(--font-weight-normal)
    text-transform: uppercase
    letter-spacing: 3px
    text-align: center
    position: relative

    &::after
      content: ''
      position: absolute
      bottom: calc(var(--spacing) * -2)
      left: 50%
      transform: translateX(-50%)
      width: 60px
      height: 1px
      background: linear-gradient(90deg, transparent 0%, var(--color-primary) 50%, transparent 100%)

  .currency-section
    display: flex
    flex-direction: column
    align-items: center
    margin-bottom: calc(var(--spacing) * 6)
    position: relative

  .currency
    color: var(--color-primary)
    font-size: calc(var(--font-size-base) * 6)
    font-weight: var(--font-weight-black)
    text-transform: uppercase
    letter-spacing: 8px
    line-height: var(--line-height-tight)
    text-shadow: 0 0 30px rgba(219, 197, 45, 0.3)
    position: relative
    margin-bottom: calc(var(--spacing) * 2)

    &::before
      content: ''
      position: absolute
      top: -10px
      left: -10px
      right: -10px
      bottom: -10px
      border: 2px solid transparent
      border-image: linear-gradient(45deg, transparent, var(--color-primary), transparent) 1
      border-radius: calc(var(--border-radius) * 3)
      opacity: 0.3

  .currency-label
    color: rgba(255, 255, 255, 0.6)
    font-size: calc(var(--font-size-base) * 0.8)
    font-weight: var(--font-weight-medium)
    text-transform: uppercase
    letter-spacing: 2px

  .inflation-section
    display: flex
    flex-direction: column
    align-items: center
    padding: calc(var(--spacing) * 4)
    background: rgba(0, 0, 0, 0.4)
    border-radius: var(--border-radius)
    border: 1px solid rgba(219, 197, 45, 0.1)
    position: relative

  .inflation-label
    color: rgba(255, 255, 255, 0.7)
    font-size: calc(var(--font-size-base) * 0.9)
    font-weight: var(--font-weight-medium)
    text-transform: uppercase
    letter-spacing: 1px
    margin-bottom: calc(var(--spacing) * 2)

  .inflation-value
    color: var(--color-primary)
    font-size: calc(var(--font-size-base) * 3.5)
    font-weight: var(--font-weight-black)
    text-shadow: 0 0 20px rgba(219, 197, 45, 0.4)
    position: relative

    &::after
      content: ''
      position: absolute
      bottom: -5px
      left: 0
      right: 0
      height: 2px
      background: linear-gradient(90deg, transparent 0%, var(--color-primary) 50%, transparent 100%)
      opacity: 0.5

  .inflation-period
    color: rgba(255, 255, 255, 0.5)
    font-size: calc(var(--font-size-base) * 0.75)
    font-weight: var(--font-weight-normal)
    margin-top: calc(var(--spacing))
    font-style: italic

.country-modal__chart-container
  position: relative
  height: 400px
  padding: calc(var(--spacing) * 4)
  background: rgba(0, 0, 0, 0.2)
  border: 1px solid rgba(255, 255, 255, 0.1)
  border-radius: var(--border-radius)
  overflow: hidden

  .chart-data-source
    position: absolute
    bottom: calc(var(--spacing) * 2)
    right: calc(var(--spacing) * 2)
    
    color: rgba(255, 255, 255, 0.4)
    font-size: calc(var(--font-size-base) * 0.7)
    font-weight: var(--font-weight-normal)
    font-style: italic
    text-align: right

  .chart-missing-data
    position: absolute
    bottom: calc(var(--spacing) * 2)
    left: calc(var(--spacing) * 2)
    
    color: rgba(255, 255, 255, 0.4)
    font-size: calc(var(--font-size-base) * 0.65)
    font-weight: var(--font-weight-medium)
    text-align: left
    text-transform: uppercase
    letter-spacing: 0.5px

.country-modal__chart-section
  position: relative
  height: 400px
  padding: calc(var(--spacing) * 4)
  background: rgba(0, 0, 0, 0.2)
  border: 1px solid rgba(255, 255, 255, 0.1)
  border-radius: var(--border-radius)
  overflow: hidden

  .country-modal__radio-group
    display: flex
    gap: calc(var(--spacing) * 3)
    margin-bottom: calc(var(--spacing) * 3)
    padding: calc(var(--spacing) * 2)
    border-radius: calc(var(--border-radius))
    border: 1px solid rgba(255, 255, 255, 0.05)
    
    label
      display: flex
      align-items: center
      gap: calc(var(--spacing) * 1.5)
      color: var(--color-white)
      cursor: pointer
      transition: var(--transition-fast)
      padding: calc(var(--spacing) * 1.5) calc(var(--spacing) * 2)
      border-radius: calc(var(--border-radius) / 2)
      font-weight: var(--font-weight-medium)
      text-transform: uppercase
      letter-spacing: 1px
      font-size: calc(var(--font-size-base) * 0.85)

      &:hover
        color: var(--color-primary)
        background: rgba(219, 197, 45, 0.05)

      input[type="radio"]
        accent-color: var(--color-primary)
        width: 16px
        height: 16px

  .chart-wrapper
    height: calc(100% - 80px)
    position: relative

.country-modal__radio-group
  display: flex
  gap: calc(var(--spacing) * 4)
  margin-bottom: calc(var(--spacing) * 4)
  justify-content: center
  padding: calc(var(--spacing) * 3)
  border-radius: calc(var(--border-radius) * 2)

.country-modal__description
  position: relative
  
  padding: calc(var(--spacing) * 6)
  background: transparent
  border: none
  
  color: var(--color-white)
  font-size: calc(var(--font-size-base) * 1.1)
  line-height: var(--line-height-relaxed)

  p
    margin: 0 0 calc(var(--spacing) * 4) 0
    
    &:last-child
      margin-bottom: 0

    &:first-letter
      color: var(--color-primary)
      font-size: calc(var(--font-size-base) * 1.3)
      font-weight: var(--font-weight-bold)

  small
    display: block
    margin-top: calc(var(--spacing) * 3)
    
    color: rgba(255, 255, 255, 0.6)
    font-size: calc(var(--font-size-base) * 0.8)
    font-weight: var(--font-weight-bold)
    text-align: left
    text-transform: uppercase
    letter-spacing: 0.5px

.country-modal__metric
  position: relative
  
  display: flex
  flex-direction: column
  align-items: center
  justify-content: center
  gap: calc(var(--spacing) * 3)
  min-height: 200px
  padding: calc(var(--spacing) * 6)
  background: linear-gradient(135deg, rgba(219, 197, 45, 0.05) 0%, rgba(0, 0, 0, 0.3) 100%)
  border: 1px solid rgba(219, 197, 45, 0.2)
  border-radius: calc(var(--border-radius) * 2)
  overflow: hidden
  
  text-align: center

  &::before
    position: absolute
    top: 0
    left: 0
    right: 0
    
    height: 2px
    background: linear-gradient(90deg, transparent 0%, var(--color-primary) 50%, transparent 100%)
    
    content: ''

  .metric-title
    color: rgba(255, 255, 255, 0.7)
    font-size: calc(var(--font-size-base) * 0.9)
    font-weight: var(--font-weight-medium)
    text-transform: uppercase
    letter-spacing: 2px

  .metric-value
    position: relative
    
    color: var(--color-primary)
    font-size: calc(var(--font-size-base) * 2.5)
    font-weight: var(--font-weight-black)
    text-shadow: 0 0 20px rgba(219, 197, 45, 0.4)

    &::after
      position: absolute
      bottom: -5px
      left: 50%
      
      width: 80%
      height: 2px
      background: linear-gradient(90deg, transparent 0%, var(--color-primary) 50%, transparent 100%)
      
      transform: translateX(-50%)
      opacity: 0.5
      content: ''

  .metric-subtitle
    color: rgba(255, 255, 255, 0.5)
    font-size: calc(var(--font-size-base) * 0.8)
    font-weight: var(--font-weight-normal)
    font-style: italic
  overflow: hidden
  min-height: 200px
  justify-content: center

  &::before
    content: ''
    position: absolute
    top: 0
    left: 0
    right: 0
    height: 2px
