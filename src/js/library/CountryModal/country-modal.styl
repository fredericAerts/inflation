      transform: translateX(-50%)
      width: 80%
      height: 2px
      background: linear-gradient(90deg, transparent 0%, var(--color-primary) 50%, transparent 100%)
      opacity: 0.5

  .metric-subtitle
    color: rgba(255, 255, 255, 0.5)
    font-size: calc(var(--font-size-base) * 0.8)
    font-weight: var(--font-weight-normal)
    font-style: italic
    font-style: italic
    font-style: italic
    font-style: italic

  .metric-data-source
    position: absolute
    bottom: var(--spacing)
    right: calc(var(--spacing) * 2)
    
    color: rgba(255, 255, 255, 0.4)
    font-size: calc(var(--font-size-base) * 0.65)
    font-weight: var(--font-weight-normal)
    font-style: italic
    text-align: right

.currency-performance-indicator
  display: flex
  align-items: center
  gap: 8px
  margin-left: auto
  
  &__label
    font-size: 12px
    color: rgba(255, 255, 255, 0.7)
    font-weight: normal
  
  &__perf
    display: flex
    align-items: center
    gap: 4px
    
    &__value
      font-size: 14px
      font-weight: bold
      color: #ff4444
    
    &__arrow
      width: 0
      height: 0
      border-left: 4px solid transparent
      border-right: 4px solid transparent
      border-top: 6px solid #ff4444
      
    &--positive
      .currency-performance-indicator__perf__value
        color: #44ff44
        
      .currency-performance-indicator__perf__arrow
        border-top: none
        border-bottom: 6px solid #44ff44
