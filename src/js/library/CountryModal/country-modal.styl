.country-modal
  position: fixed
  top: 0
  left: 0
  width: 100%
  height: 100%
  background-color: rgba(0, 0, 0, 0.5)
  display: flex
  align-items: center
  justify-content: center
  z-index: 1000

  &__content
    background: white
    border-radius: 8px
    padding: 24px
    max-width: 400px
    width: 90%
    max-height: 80vh
    overflow-y: auto
    position: relative

  &__header
    display: flex
    justify-content: space-between
    align-items: flex-start
    margin-bottom: 16px

  &__title
    margin: 0
    font-size: 1.5rem
    color: #333

  &__close
    background: none
    border: none
    font-size: 24px
    cursor: pointer
    padding: 0
    width: 32px
    height: 32px
    display: flex
    align-items: center
    justify-content: center
    color: #666
    
    &:hover
      color: #333

  &__body
    color: #555
    line-height: 1.5
    
    p
      margin: 0 0 12px 0
      
      &:last-child
        margin-bottom: 0

    strong
      color: #333
